---
/**
 * AppPreview: the owner adds a logo, a name, a phrase and a color, and sees their app and its App Store and
 * Google Play listings follow. It all happens in the browser; nothing is uploaded.
 * The listings credit Tutreino as the developer, since the apps are published under its name.
 * Every discipline's classes are rendered up front and the script only shows the chosen one.
 */
import WaGlyph from './WaGlyph.astro';
import { waLink } from '../utils/meta';

const marks = {
  iron: 'M6 4h3v16H6zm9 0h3v16h-3zM4 9h16v6H4z',
  zen: 'M12 2 4 7v10l8 5 8-5V7zm0 4 4 2.5v5L12 16l-4-2.5v-5z',
  flow: 'm13 2-9 12h7l-2 8 9-12h-7z',
};
const examples = [
  { name: 'Iron House', tag: 'Fuerza y funcional', color: '#1d4ed8', disc: 'funcional', mark: marks.iron },
  { name: 'Zen Studio', tag: 'Yoga y movimiento', color: '#047857', disc: 'yoga', mark: marks.zen },
  { name: 'Flow Gym', tag: 'Spinning todos los días', color: '#c2410c', disc: 'spinning', mark: marks.flow },
];
const swatches = [
  { label: 'Azul', color: '#1d4ed8' },
  { label: 'Verde', color: '#047857' },
  { label: 'Naranja', color: '#c2410c' },
  { label: 'Rojo', color: '#b91c1c' },
  { label: 'Violeta', color: '#6d28d9' },
  { label: 'Negro', color: '#111827' },
];
// tag: the phrase on the store listings when there's no field for it (phones)
// classes: [time, name, detail, open | full | mine]
const disciplines = [
  { id: 'funcional', label: 'Funcional', tag: 'Fuerza y funcional', classes: [['07:00', 'Funcional', 'Sala 1 · 4 lugares', 'open'], ['12:30', 'Cross', 'Lleno', 'full'], ['19:00', 'Funcional', 'Tu lugar está reservado', 'mine'], ['20:30', 'Spinning', 'Sala 2 · 9 lugares', 'open']] },
  { id: 'crossfit', label: 'Crossfit', tag: 'Crossfit todos los días', classes: [['07:00', 'WOD', 'Box 1 · 6 lugares', 'open'], ['12:30', 'Halterofilia', 'Lleno', 'full'], ['18:30', 'WOD', 'Tu lugar está reservado', 'mine'], ['20:00', 'Open box', 'Box 2 · 8 lugares', 'open']] },
  { id: 'musculacion', label: 'Musculación', tag: 'Musculación y fuerza', classes: [['07:00', 'Sala de pesas', '12 lugares', 'open'], ['12:30', 'Funcional', 'Lleno', 'full'], ['20:00', 'Sala de pesas', 'Tu lugar está reservado', 'mine'], ['21:00', 'Tren superior', 'Sala 2 · 5 lugares', 'open']] },
  { id: 'spinning', label: 'Spinning', tag: 'Spinning todos los días', classes: [['07:00', 'Spinning', 'Sala 2 · 9 lugares', 'open'], ['12:30', 'Cycle power', 'Lleno', 'full'], ['20:30', 'Spinning', 'Tu lugar está reservado', 'mine'], ['21:30', 'Spinning suave', 'Sala 2 · 6 lugares', 'open']] },
  { id: 'yoga', label: 'Yoga', tag: 'Yoga y movimiento', classes: [['07:00', 'Hatha', 'Sala 1 · 5 lugares', 'open'], ['08:00', 'Yoga Flow', 'Tu lugar está reservado', 'mine'], ['12:30', 'Vinyasa', 'Lleno', 'full'], ['19:00', 'Meditación', 'Sala 2 · 8 lugares', 'open']] },
  { id: 'pilates', label: 'Pilates', tag: 'Pilates y movimiento', classes: [['08:00', 'Mat', 'Sala 1 · 3 lugares', 'open'], ['10:00', 'Reformer', 'Tu lugar está reservado', 'mine'], ['12:30', 'Reformer', 'Lleno', 'full'], ['19:00', 'Mat', 'Sala 1 · 6 lugares', 'open']] },
];
const [firstExample] = examples;
const views = [{ view: 'app', tab: 'Tu app' }, { view: 'appstore', tab: 'App Store' }, { view: 'play', tab: 'Google Play' }];
// store screenshots: their caption and which row of the mini app is highlighted
const shots = [{ caption: 'Reservá tu clase', on: 0 }, { caption: 'Pagá en segundos', on: 1 }, { caption: 'Seguí tu rutina', on: 2 }];
---

<section class="h-section h-chalk h-bld-sec" id="tu-app" data-cta-bar-hide>
  <div class="h-wrap">
    <div class="h-head">
      <p class="h-kicker">Probalo con tu gimnasio</p>
      <h2 class="h-h2">Mirá cómo queda tu app.</h2>
      <p class="h-sub">Subí tu logo, ponele nombre y elegí tu color. Así se ve tu app, y así aparece en las tiendas.</p>
    </div>

    <div class="h-bld">
      <form class="h-bf" novalidate>
        <div class="h-bf-row">
          <span class="h-bf-lab">Tu logo</span>
          <input class="h-bf-file" type="file" id="h-bf-file" accept="image/*" aria-label="Subí tu logo" />
          <label class="h-bf-drop" for="h-bf-file">
            <span class="h-bic" data-bld-icon aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d={firstExample.mark} /></svg></span>
            <span><b>Subí tu logo</b><small>PNG, JPG o SVG. Queda en tu navegador, no lo guardamos.</small></span>
          </label>
          <p class="h-bf-ex">
            <span>¿No lo tenés a mano? Probá con</span>
            {examples.map((e, i) => <button type="button" data-name={e.name} data-tag={e.tag} data-color={e.color} data-trains={e.disc} data-mark={e.mark} aria-pressed={i === 0 ? 'true' : 'false'}>{e.name}</button>)}
          </p>
          <p class="h-bf-status" role="status"></p>
        </div>

        <div class="h-bf-row h-bf-row-name">
          <label class="h-bf-lab" for="h-bf-name">Nombre de tu gimnasio <span class="h-bf-count" id="h-bf-name-count" aria-hidden="true">{firstExample.name.length}/30</span></label>
          <input class="h-bf-input" id="h-bf-name" type="text" maxlength="30" autocomplete="organization" autocapitalize="words" autocorrect="off" spellcheck="false" enterkeyhint="next" placeholder="Ej: Iron House" value={firstExample.name} />
        </div>

        <div class="h-bf-row h-bf-row-tag">
          <label class="h-bf-lab" for="h-bf-tag">Frase corta <span class="h-bf-count" id="h-bf-tag-count" aria-hidden="true">{firstExample.tag.length}/30</span></label>
          <input class="h-bf-input" id="h-bf-tag" type="text" maxlength="30" autocomplete="off" enterkeyhint="done" placeholder="Ej: Fuerza y funcional" value={firstExample.tag} />
          <p class="h-bf-hint">Va debajo del nombre en las tiendas.</p>
        </div>

        <fieldset class="h-bf-row">
          <legend class="h-bf-lab">Tu color</legend>
          <div class="h-sws">
            <span class="h-sws-logo"></span>
            <span class="h-sw-sep" hidden></span>
            {swatches.map((s) => <button type="button" class="h-sw" style={`--c:${s.color}`} data-color={s.color} aria-label={s.label} title={s.label} aria-pressed={s.color === firstExample.color ? 'true' : 'false'}></button>)}
            <label class="h-sw-other"><input type="color" id="h-bf-color" value={firstExample.color} aria-label="Elegir otro color" />Otro</label>
          </div>
        </fieldset>

        <fieldset class="h-bf-row">
          <legend class="h-bf-lab">¿Qué entrenan?</legend>
          <div class="h-bf-chips">
            {disciplines.map((d, i) => <button type="button" data-disc-btn={d.id} data-tag={d.tag} aria-pressed={i === 0 ? 'true' : 'false'}>{d.label}</button>)}
          </div>
        </fieldset>

        <div class="h-bf-cta">
          <a href={waLink('Hola, vi cómo quedaría la app de mi gimnasio y quiero probar Tutreino 30 días gratis.')} data-wa-base={waLink('')} class="h-btn" target="_blank" rel="noopener noreferrer"><WaGlyph />Quiero esta app</a>
          <p class="h-bf-pro">La app con tu marca viene en el <b>plan Pro</b>. En las tiendas se publica a nombre de Tutreino.</p>
        </div>
      </form>

      <div class="h-bld-stage" data-view="app">
        <div class="h-bld-tabs" role="group" aria-label="Qué vista mostrar">
          {views.map((v, i) => <button type="button" data-view-btn={v.view} aria-pressed={i === 0 ? 'true' : 'false'}>{v.tab}</button>)}
        </div>
        <div class="h-bld-crop">
          <div class="h-bld-row">
            <figure class="h-bpv h-bpv-main" data-screen="app">
              <div class="h-mphone" aria-hidden="true">
                <div class="h-mscreen">
                  <div class="h-ma-top"><span class="h-bic" data-bld-icon><svg viewBox="0 0 24 24"><path fill="currentColor" d={firstExample.mark} /></svg></span><span class="h-ma-name" data-bld-name>{firstExample.name}</span></div>
                  <p class="h-ma-over">Hola, Marcos</p>
                  <p class="h-ma-title">Clases</p>
                  <div class="h-ma-days"><span class="on">Hoy</span><span>Mañana</span><span>Vie</span><span>Sáb</span></div>
                  {disciplines.map((d, i) => (
                    <ul class="h-ma-list" data-disc={d.id} hidden={i > 0}>
                      {d.classes.map(([time, name, detail, kind]) => (
                        <li class:list={[kind === 'mine' && 'mine']}>
                          <span class="h-ma-t">{time}</span>
                          <span class="h-ma-c"><b>{name}</b><small>{detail}</small></span>
                          <span class:list={['h-ma-a', kind === 'full' && 'ghost']}>{kind === 'open' ? 'Reservar' : kind === 'full' ? 'En espera' : '✓'}</span>
                        </li>
                      ))}
                    </ul>
                  ))}
                  <div class="h-ma-tab"><span class="on"></span><span></span><span></span><span></span></div>
                </div>
              </div>
              <figcaption>Tu app</figcaption>
            </figure>

            <figure class="h-bpv" data-screen="appstore">
              <div class="h-mphone" aria-hidden="true">
                <div class="h-lst">
                  <div class="h-lst-bar"><span class="h-as-back">‹ Apps</span><span class="h-lst-pv">Vista previa</span></div>
                  <div class="h-lst-top">
                    <span class="h-bic h-bic-edge" data-bld-icon style="--s:66px"><svg viewBox="0 0 24 24"><path fill="currentColor" d={firstExample.mark} /></svg></span>
                    <div class="h-lst-txt">
                      <div class="h-lst-title" data-bld-name>{firstExample.name}</div>
                      <div class="h-lst-subt" data-bld-tag>{firstExample.tag}</div>
                      <span class="h-as-get">Obtener</span>
                    </div>
                  </div>
                  <div class="h-as-stats">
                    <div><small>Edad</small><b>4+</b></div>
                    <div><small>Categoría</small><b>Salud</b></div>
                    <div><small>Idioma</small><b>ES</b></div>
                  </div>
                  <div class="h-shots">
                    {shots.map((s) => (
                      <div class="h-shot"><p>{s.caption}</p><div class="h-mini"><em data-bld-name>{firstExample.name}</em>{[0, 1, 2, 3].map((n) => <i class:list={[n === s.on && 'on', n === 0 && 'lg']}></i>)}</div></div>
                    ))}
                  </div>
                  <p class="h-lst-desc">Reservá clases, pagá tu membresía y seguí tu rutina desde el celular.</p>
                  <div class="h-as-dev">Tutreino</div>
                </div>
              </div>
              <figcaption>En App Store</figcaption>
            </figure>

            <figure class="h-bpv" data-screen="play">
              <div class="h-mphone" aria-hidden="true">
                <div class="h-lst h-gp">
                  <div class="h-lst-bar"><span></span><span class="h-lst-pv">Vista previa</span></div>
                  <div class="h-lst-top">
                    <span class="h-bic h-bic-edge" data-bld-icon style="--s:58px"><svg viewBox="0 0 24 24"><path fill="currentColor" d={firstExample.mark} /></svg></span>
                    <div class="h-lst-txt">
                      <div class="h-lst-title" data-bld-name>{firstExample.name}</div>
                      <div class="h-gp-dev">Tutreino</div>
                    </div>
                  </div>
                  <div class="h-gp-stats"><span><b>Nueva</b>app</span><span><b>Para todos</b>clasificación</span><span><b>Salud</b>categoría</span></div>
                  <span class="h-gp-install">Instalar</span>
                  <div class="h-shots">
                    {shots.map((s) => (
                      <div class="h-shot"><p>{s.caption}</p><div class="h-mini"><em data-bld-name>{firstExample.name}</em>{[0, 1, 2, 3].map((n) => <i class:list={[n === s.on && 'on', n === 0 && 'lg']}></i>)}</div></div>
                    ))}
                  </div>
                  <p class="h-gp-about">Acerca de esta app</p>
                  <p class="h-lst-desc" data-bld-tag>{firstExample.tag}</p>
                </div>
              </div>
              <figcaption>En Google Play</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { track } from '@vercel/analytics';

  type Rgb = [number, number, number];
  type Logo = { kind: 'mark'; path: string } | { kind: 'upload'; src: string; bg: string; pad: boolean } | null;

  const root = document.querySelector<HTMLElement>('.h-bld-sec');
  if (root) {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s) as T;
    const qa = <T extends Element>(s: string) => Array.from(root.querySelectorAll<T>(s));
    const press = (el: Element, on: boolean) => el.setAttribute('aria-pressed', String(on));

    const nameIn = q<HTMLInputElement>('#h-bf-name');
    const tagIn = q<HTMLInputElement>('#h-bf-tag');
    const fileIn = q<HTMLInputElement>('#h-bf-file');
    const colorIn = q<HTMLInputElement>('#h-bf-color');
    const statusEl = q<HTMLElement>('.h-bf-status');
    const drop = q<HTMLElement>('.h-bf-drop');
    const cta = q<HTMLAnchorElement>('.h-bf-cta a');
    const logoSwatches = q<HTMLElement>('.h-sws-logo');
    const exampleBtns = qa<HTMLButtonElement>('.h-bf-ex button');
    const phone = matchMedia('(max-width: 760px)');

    const firstBtn = exampleBtns[0];
    let name = firstBtn.dataset.name || '';
    let tag = firstBtn.dataset.tag || '';
    let example: string | null = name;
    let logo: Logo = { kind: 'mark', path: firstBtn.dataset.mark || '' };

    /* ── color ── */
    const WHITE: Rgb = [255, 255, 255];
    const INK: Rgb = [11, 18, 32];
    const rgb = (hex: string): Rgb => { const n = parseInt(hex.slice(1), 16); return [n >> 16 & 255, n >> 8 & 255, n & 255]; };
    const hex = (c: number[]) => '#' + c.map((v) => Math.round(v).toString(16).padStart(2, '0')).join('');
    const mix = (a: Rgb, b: Rgb, t: number) => a.map((v, i) => v + (b[i] - v) * t) as Rgb;
    const lum = (c: number[]) => {
      const [r, g, b] = c.map((v) => { const s = v / 255; return s <= .03928 ? s / 12.92 : ((s + .055) / 1.055) ** 2.4; });
      return .2126 * r + .7152 * g + .0722 * b;
    };
    const contrast = (a: number[], b: number[]) => { const [x, y] = [lum(a), lum(b)]; return (Math.max(x, y) + .05) / (Math.min(x, y) + .05); };

    /* any color has to work: text flips to dark on pale colors, and the gym name darkens until it reads on the tint */
    const setColor = (color: string) => {
      const c = rgb(color);
      const soft = mix(c, WHITE, .86);
      const on = contrast(c, WHITE) >= 4.5 || contrast(c, WHITE) >= contrast(c, INK) ? WHITE : INK;
      let ink = c;
      for (let i = 0; i < 24 && contrast(ink, soft) < 4.5; i++) ink = ink.map((v) => v * .88) as Rgb;
      root.style.setProperty('--gym', color);
      root.style.setProperty('--gym-soft', hex(soft));
      root.style.setProperty('--gym-on', hex(on));
      root.style.setProperty('--gym-ink', hex(ink));
      colorIn.value = color;
      qa<HTMLElement>('.h-sw').forEach((b) => press(b, b.dataset.color === color));
    };

    /* ── icon: uploaded logo, example mark or initials ── */
    const initials = () => {
      const words = (name.trim() || 'Tu gimnasio').split(/\s+/);
      return (words[0][0] + (words[1] ? words[1][0] : '')).toUpperCase();
    };
    const iconNode = () => {
      if (logo?.kind === 'upload') { const im = new Image(); im.alt = ''; im.src = logo.src; return im; }
      if (logo?.kind === 'mark') {
        const ns = 'http://www.w3.org/2000/svg';
        const svg = document.createElementNS(ns, 'svg');
        const path = document.createElementNS(ns, 'path');
        svg.setAttribute('viewBox', '0 0 24 24');
        path.setAttribute('fill', 'currentColor');
        path.setAttribute('d', logo.path);
        svg.append(path);
        return svg;
      }
      const span = document.createElement('span');
      span.textContent = initials();
      return span;
    };
    const paintIcons = (pop: boolean) => {
      qa<HTMLElement>('[data-bld-icon]').forEach((el) => {
        el.replaceChildren(iconNode());
        el.classList.toggle('pad', logo?.kind === 'upload' && logo.pad);
        el.style.background = logo?.kind === 'upload' ? logo.bg : '';
        if (pop) { el.classList.remove('pop'); void el.offsetWidth; el.classList.add('pop'); }
      });
    };

    /* ── text and the WhatsApp message; an example gym's name never goes into the message ── */
    const paintText = () => {
      const typed = name.trim();
      qa<HTMLElement>('[data-bld-name]').forEach((el) => { el.textContent = typed || 'Tu gimnasio'; });
      qa<HTMLElement>('[data-bld-tag]').forEach((el) => { el.textContent = tag.trim() || 'Reservá, pagá y entrená'; });
      q<HTMLElement>('#h-bf-name-count').textContent = `${nameIn.value.length}/30`;
      q<HTMLElement>('#h-bf-tag-count').textContent = `${tagIn.value.length}/30`;
      const message = typed && !example
        ? `Hola, soy de ${typed}. Vi cómo quedaría nuestra app y quiero probar Tutreino 30 días gratis.`
        : 'Hola, vi cómo quedaría la app de mi gimnasio y quiero probar Tutreino 30 días gratis.';
      cta.href = (cta.dataset.waBase || '') + encodeURIComponent(message);
      exampleBtns.forEach((b) => press(b, b.dataset.name === example));
    };

    const setDisc = (id: string) => {
      qa<HTMLElement>('[data-disc]').forEach((el) => { el.hidden = el.dataset.disc !== id; });
      qa<HTMLElement>('[data-disc-btn]').forEach((b) => press(b, b.dataset.discBtn === id));
    };
    const discTag = () => q<HTMLElement>('[data-disc-btn][aria-pressed="true"]').dataset.tag || '';

    const setView = (view: string) => {
      q<HTMLElement>('.h-bld-stage').dataset.view = view;
      qa<HTMLElement>('[data-view-btn]').forEach((b) => press(b, b.dataset.viewBtn === view));
    };

    const say = (message: string, isError = false) => {
      statusEl.textContent = message;
      statusEl.classList.toggle('err', isError);
    };

    /* ── logo: sample its colors and decide how it sits in the icon ── */
    const analyze = (img: HTMLImageElement) => {
      const S = 48;
      const cv = document.createElement('canvas');
      cv.width = cv.height = S;
      const cx = cv.getContext('2d', { willReadFrequently: true }) as CanvasRenderingContext2D;
      cx.drawImage(img, 0, 0, S, S);
      const d = cx.getImageData(0, 0, S, S).data;
      let clear = 0, solid = 0, lumSum = 0;
      const buckets = new Map<string, { n: number; sum: Rgb; sat: number }>();
      for (let i = 0; i < d.length; i += 4) {
        if (d[i + 3] < 40) { clear++; continue; }
        solid++;
        const c: Rgb = [d[i], d[i + 1], d[i + 2]];
        const max = Math.max(...c), min = Math.min(...c);
        const light = (max + min) / 510;
        const sat = max === min ? 0 : (max - min) / (255 - Math.abs(max + min - 255));
        lumSum += lum(c);
        if (sat < .22 || light < .08 || light > .93) continue;
        const key = c.map((v) => v >> 5).join();
        const b = buckets.get(key) || { n: 0, sum: [0, 0, 0] as Rgb, sat: 0 };
        b.n++; b.sat += sat; c.forEach((v, k) => { b.sum[k] += v; });
        buckets.set(key, b);
      }
      const ranked = [...buckets.values()]
        .filter((b) => b.n >= Math.max(3, solid * .012))
        .map((b) => ({ c: b.sum.map((v) => v / b.n), score: b.n * (.5 + b.sat / b.n) }))
        .sort((a, b) => b.score - a.score);
      const colors: number[][] = [];
      ranked.forEach(({ c }) => {
        const near = colors.some((y) => Math.hypot(c[0] - y[0], c[1] - y[1], c[2] - y[2]) < 70);
        if (!near && colors.length < 3) colors.push(c);
      });
      const corners = [0, (S - 1) * 4, S * (S - 1) * 4, (S * S - 1) * 4];
      const corner = [0, 1, 2].map((k) => corners.reduce((sum, o) => sum + d[o + k] / 4, 0));
      return { hasAlpha: clear / (S * S) > .03, meanLum: solid ? lumSum / solid : 0, colors: colors.map(hex), corner };
    };

    const shrink = (img: HTMLImageElement, fallback: string) => {
      try {
        const max = 512, w = img.naturalWidth, h = img.naturalHeight;
        if (!w || !h || (w <= max && h <= max)) return fallback;
        const k = max / Math.max(w, h);
        const cv = document.createElement('canvas');
        cv.width = Math.round(w * k);
        cv.height = Math.round(h * k);
        (cv.getContext('2d') as CanvasRenderingContext2D).drawImage(img, 0, 0, cv.width, cv.height);
        return cv.toDataURL('image/png');
      } catch { return fallback; }
    };

    const setLogoSwatches = (colors: string[]) => {
      logoSwatches.replaceChildren(...colors.map((c, i) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'h-sw'; b.dataset.color = c;
        b.style.setProperty('--c', c);
        b.setAttribute('aria-label', `Color de tu logo ${i + 1}`);
        return b;
      }));
      q<HTMLElement>('.h-sw-sep').hidden = !colors.length;
    };

    const applyLogo = (img: HTMLImageElement, src: string) => {
      let a: ReturnType<typeof analyze> | null = null;
      try { a = analyze(img); } catch { /* an image the canvas refuses still works as a logo, just without its colors */ }
      let bg = '#ffffff', pad = true;
      if (a?.hasAlpha) bg = a.meanLum > .72 ? 'var(--gym)' : '#ffffff';
      else if (a) { bg = hex(a.corner); pad = lum(a.corner) > .8; }
      logo = { kind: 'upload', src: shrink(img, src), bg, pad };
      const colors = a ? a.colors : [];
      setLogoSwatches(colors);
      if (colors.length) setColor(colors[0]);
      else setColor(colorIn.value);
      paintIcons(true);
      if (example) { name = ''; nameIn.value = ''; tag = tagIn.value = phone.matches ? discTag() : ''; }
      example = null;
      /* phones ask for the name first, so it can already be there */
      const needsName = !name.trim();
      nameIn.classList.toggle('nudge', needsName);
      paintText();
      say((colors.length ? 'Tomamos el color de tu logo.' : 'Tu logo no tiene un color marcado: elegí uno abajo.') + (needsName ? ' Ahora escribí el nombre.' : ''));
      track('app_preview_logo');
    };

    const handleFile = (file?: File) => {
      if (!file) return;
      if (!file.type.startsWith('image/')) { say('Ese archivo no es una imagen. Probá con PNG, JPG o SVG.', true); return; }
      if (file.size > 10 * 1024 * 1024) { say('Esa imagen pesa más de 10 MB. Probá con una más liviana.', true); return; }
      const reader = new FileReader();
      reader.onerror = () => say('No pudimos leer ese archivo. Probá con otro.', true);
      reader.onload = () => {
        const src = reader.result as string;
        const img = new Image();
        img.onload = () => applyLogo(img, src);
        img.onerror = () => say('No pudimos abrir esa imagen. Probá con PNG o JPG.', true);
        img.src = src;
      };
      reader.readAsDataURL(file);
    };

    /* ── events ── */
    exampleBtns.forEach((b) => b.addEventListener('click', () => {
      name = example = b.dataset.name || '';
      tag = b.dataset.tag || '';
      nameIn.value = name;
      tagIn.value = tag;
      nameIn.classList.remove('nudge');
      logo = { kind: 'mark', path: b.dataset.mark || '' };
      fileIn.value = '';
      say('');
      setLogoSwatches([]);
      setColor(b.dataset.color || '');
      setDisc(b.dataset.trains || '');
      paintIcons(true);
      paintText();
    }));

    fileIn.addEventListener('change', () => handleFile(fileIn.files?.[0]));
    ['dragenter', 'dragover'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.add('over'); }));
    ['dragleave', 'drop'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.remove('over'); }));
    drop.addEventListener('drop', (e) => handleFile((e as DragEvent).dataTransfer?.files[0]));

    nameIn.addEventListener('input', () => {
      name = nameIn.value;
      example = null;
      nameIn.classList.remove('nudge');
      if (logo?.kind !== 'upload') { logo = null; paintIcons(false); }
      paintText();
    });
    tagIn.addEventListener('input', () => { tag = tagIn.value; paintText(); });
    /* one phone at a time: show the listing while editing the phrase that only appears there */
    tagIn.addEventListener('focus', () => setView('appstore'));
    /* Return moves on: the form has no submit button, so it would otherwise do nothing */
    nameIn.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      if (phone.matches) { nameIn.blur(); drop.parentElement?.scrollIntoView({ block: 'nearest' }); }
      else tagIn.focus();
    });
    tagIn.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); tagIn.blur(); } });

    q('.h-sws').addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('.h-sw');
      if (b?.dataset.color) setColor(b.dataset.color);
    });
    colorIn.addEventListener('input', () => setColor(colorIn.value));
    q('.h-bf-chips').addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-disc-btn]');
      if (b?.dataset.discBtn) {
        setDisc(b.dataset.discBtn);
        setView('app');
        if (phone.matches) { tag = tagIn.value = discTag(); paintText(); }
      }
    });
    q('.h-bld-tabs').addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-view-btn]');
      if (b?.dataset.viewBtn) setView(b.dataset.viewBtn);
    });
    q('.h-bf').addEventListener('submit', (e) => e.preventDefault());
    cta.addEventListener('click', () => track('app_preview_cta', { logo: logo?.kind === 'upload', named: !example && !!name.trim() }));

    /* phones start empty: deleting a sample name is a slow first step, and the preview says "Tu gimnasio" until they type */
    if (phone.matches) { name = ''; example = null; nameIn.value = ''; paintText(); }
  }
</script>

