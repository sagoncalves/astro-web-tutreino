---
/**
 * DiscoLogo: the Tutreino logo (blue circle, dumbbell and progress arrow, same drawing as
 * src/assets/logo.svg) next to "tutreino" in League Spartan 800. Used by the /v2 review page.
 * It sizes from the parent's font-size and takes the parent's text color.
 */
---

<span class="logo-disco" role="img" aria-label="Tutreino"><svg viewBox="0 0 1024 1024" aria-hidden="true"><circle cx="512" cy="512" r="512" fill="#007aff"/><g fill="#fff"><rect x="303" y="301.5" width="71" height="417" rx="22"/><rect x="650" y="301.5" width="71" height="417" rx="22"/><rect x="222" y="357.5" width="61" height="305" rx="20"/><rect x="741" y="357.5" width="61" height="305" rx="20"/><rect x="141" y="432" width="61" height="156" rx="20"/><rect x="822" y="432" width="61" height="156" rx="20"/><rect x="370" y="474" width="284" height="72"/></g><path d="M352 796Q490 860 668 776M578.3 755.7L668 776L626.6 858.2" fill="none" stroke="#fff" stroke-width="44" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="logo-disco-name">tutreino</span></span>

<style>
  .logo-disco {
    display: inline-flex; align-items: center; gap: 0.3em; white-space: nowrap;
    font-family: 'League Spartan', sans-serif; font-weight: 800; line-height: 1; letter-spacing: -0.045em;
  }
  .logo-disco svg { width: 1.25em; height: 1.25em; flex-shrink: 0; }
</style>
