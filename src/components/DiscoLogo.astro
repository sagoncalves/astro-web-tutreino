---
/**
 * DiscoLogo: the Disco identity lockup used by the /v2 review page. The weight plate
 * wrapped by a rising arrow as the icon, then "tutreino" in League Spartan 800.
 * It sizes from the parent's font-size and takes the parent's text color.
 */
---

<span class="logo-disco" role="img" aria-label="Tutreino"><svg viewBox="0 0 200 200" aria-hidden="true"><path fill="#007aff" fill-rule="evenodd" d="M0 100a100 100 0 1 0 200 0a100 100 0 1 0 -200 0ZM87 100a13 13 0 1 0 26 0a13 13 0 1 0 -26 0Z"/><path fill="#3d97ff" fill-rule="evenodd" d="M70 100a30 30 0 1 0 60 0a30 30 0 1 0 -60 0ZM87 100a13 13 0 1 0 26 0a13 13 0 1 0 -26 0Z"/><path d="M30.21 67.46A77 77 0 1 0 171.83 127.75" fill="none" stroke="#fff" stroke-width="16" stroke-linecap="round"/><path d="M187.21 132.3L176.95 97.31L157.2 121.19Z" fill="#fff" stroke="#fff" stroke-width="3" stroke-linejoin="round"/></svg><span class="logo-disco-name">tutreino</span></span>

<style>
  .logo-disco {
    display: inline-flex; align-items: center; gap: 0.3em; white-space: nowrap;
    font-family: 'League Spartan', sans-serif; font-weight: 800; line-height: 1; letter-spacing: -0.045em;
  }
  .logo-disco svg { width: 1.25em; height: 1.25em; flex-shrink: 0; }
</style>
