---
/**
 * SiteLayout — the full-page shell used by every route.
 * Handles: fonts, the h-root chrome, Navbar, Footer, the WhatsApp entry points,
 * and all shared design-system CSS (tokens, type scale, nav, footer, legal pages).
 *
 * Pass all Layout/meta props through; they are forwarded to Layout.astro.
 */
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WaGlyph from '../components/WaGlyph.astro';
import { WA } from '../utils/meta';

export interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: string;
  ogUrl?: string;
  ogSiteName?: string;
  ogLocale?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  ogImageType?: string;
  ogImageAlt?: string;
  twitterCard?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  twitterImageAlt?: string;
  canonical?: string;
  robots?: string;
  /** Pass true on the index page so nav links use #anchors instead of /#anchors */
  home?: boolean;
  /** Alternate look for review copies of the site (the Disco theme is used by /v2) */
  theme?: 'disco';
  /**
   * Phones get a sticky "Probar 30 días gratis" bar instead of the floating WhatsApp button.
   * The bar stays hidden while any element marked data-cta-bar-hide is on screen.
   */
  ctaBar?: boolean;
}

const { home, theme, ctaBar, ...props } = Astro.props;
const fontsHref = 'https://fonts.googleapis.com/css2?family=League+Spartan:wght@600;700;800&family=Atkinson+Hyperlegible+Next:wght@400;600;700&display=swap';
---

<Layout {...props} showHeader={false} showFooter={false}>
  <!-- Google Fonts -->
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet" href={fontsHref} />
  <!-- Forward pages' head content (e.g. JSON-LD) to Layout's <head> -->
  <slot name="head" slot="head" />

  <div class:list={['h-root', theme && `h-theme-${theme}`, ctaBar && 'h-has-bar']}>
    <Navbar home={home} theme={theme} />

    <slot />

    <Footer theme={theme} />

    <a href={WA.demo} class="h-wa-fab" target="_blank" rel="noopener noreferrer" aria-label="Escribinos por WhatsApp">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    {ctaBar && (
      <div class="h-bar" data-cta-bar>
        <a href={WA.trial} class="h-bar-btn" target="_blank" rel="noopener noreferrer"><WaGlyph />Probar 30 días gratis</a>
        <p class="h-bar-note">Se abre WhatsApp · Sin tarjeta</p>
      </div>
    )}
  </div>
</Layout>

<script>
  // Sticky trial bar (phones): shown once the hero has scrolled away, hidden again over the closing call and the footer
  const bar = document.querySelector<HTMLElement>('[data-cta-bar]');
  if (bar && 'IntersectionObserver' in window) {
    const onScreen = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? onScreen.add(e.target) : onScreen.delete(e.target)));
      bar.classList.toggle('is-shown', onScreen.size === 0);
    });
    document.querySelectorAll('[data-cta-bar-hide]').forEach((el) => io.observe(el));
  }
</script>

<style is:global>
/* Atkinson Hyperlegible Next only ships a slashed zero, so the plain zero comes from Albert Sans:
   a 1.4 KB subset that holds just "0", so every other character stays Atkinson */
@font-face {
  font-family: 'Tutreino Zero';
  src: url('/fonts/albert-sans-zero.woff2') format('woff2');
  font-weight: 400 700;
  font-display: swap;
  unicode-range: U+0030;
}

/* ── Design tokens ─────────────────────────────────────────── */
/* League Spartan 800 for headlines, numbers and the name; Atkinson Hyperlegible Next for text and
   labels, in sentence case. The logo blue and its ink tone carry the brand; weight-plate red,
   yellow and green only mark status. Flat surfaces, chalk bands, white cards. */
.h-root {
  --f-head: 'League Spartan', Futura, 'Century Gothic', sans-serif;
  --f-text: 'Tutreino Zero', 'Atkinson Hyperlegible Next', ui-sans-serif, system-ui, sans-serif;
  /* display sizes: four steps, each at least 1.25x the next */
  --t-hero: clamp(44px, 7vw, 96px);
  --t-final: clamp(40px, 6vw, 72px);
  --t-h2: clamp(34px, 4.6vw, 56px);
  --t-h2-quiet: clamp(30px, 3.4vw, 40px);

  --brand: #007aff;       /* the logo blue: logo, closing band, large type (4.0:1 on white) */
  --brand-ink: #0062d6;   /* buttons, links, small blue text (5.7:1 on white) */
  --brand-deep: #004fae;
  --brand-soft: #e5f1ff;
  --bg: #ffffff;
  --bg-2: #f4f6fa;        /* chalk bands */
  --panel: #ffffff;
  --panel-2: #f4f6fa;
  --line: #e2e7ef;
  --line-2: #cdd5e1;
  --ink: #0b1220;
  --ink-2: #4a5a73;
  --mute: #5d6c84;        /* 5.3:1 on white */
  --ok: #0b6b35; --ok-soft: #e2f5e9;
  --risk: #a3150f; --risk-soft: #fde8e7;
  --pending: #7a5600; --pending-soft: #fff3c4;
  --plate-red: #e5322d; --plate-yellow: #ffc400;
  --wa: #25d366;
  /* older names still used by the subpages */
  --green: var(--brand-ink); --green-deep: var(--brand-deep);
  --lime: var(--brand-ink); --lime-soft: var(--brand-soft);
  --red: var(--plate-red); --warn: var(--pending);

  background: var(--bg);
  color: var(--ink);
  font-family: var(--f-text);
  font-size: 16px;
  line-height: 1.55;
  position: relative;
  /* clip, not hidden: hidden makes .h-root a scroll container and breaks the sticky nav */
  overflow-x: hidden;
  overflow-x: clip;
  min-height: 100vh;
}
.h-root * { box-sizing: border-box; }
.h-root h1, .h-root h2, .h-root h3 { text-wrap: balance; }
.h-root p { text-wrap: pretty; }
/* anchors land below the sticky nav */
.h-root [id] { scroll-margin-top: 76px; }

/* single emphasized phrase in a heading */
.h-grad { color: var(--brand-ink); }
.wa-glyph { width: 18px; height: 18px; flex-shrink: 0; }

/* ── Navbar ────────────────────────────────────────────────── */
.h-nav {
  position: sticky; top: 0; z-index: 50;
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  padding: 10px calc(max(0px, (100% - 1280px) / 2) + clamp(20px, 4vw, 48px));
  background: rgba(255, 255, 255, .96);
  border-bottom: 1px solid var(--line);
}
.h-logo { display: inline-flex; align-items: center; gap: 9px; text-decoration: none; color: var(--ink); }
.h-logo-img { width: 30px; height: 30px; display: block; flex-shrink: 0; }
.h-logo-name { font-family: var(--f-head); font-weight: 700; font-size: 25px; line-height: 1; letter-spacing: -0.045em; color: var(--ink); }
.h-nav .h-logo { font-size: 24px; }
.h-nav-links { display: flex; align-items: center; gap: 2px; }
.h-nav-links a {
  padding: 8px 12px; font-size: 15px; font-weight: 700; color: var(--ink);
  text-decoration: none; border-radius: 8px;
  transition: background .18s ease;
}
.h-nav-links a:hover { background: var(--bg-2); }
.h-nav-right { display: inline-flex; align-items: center; gap: 8px; }
.h-cta-mini {
  display: inline-flex; align-items: center; gap: 8px;
  height: 40px; padding: 0 16px;
  background: var(--brand-ink); color: #fff;
  text-decoration: none; border-radius: 10px;
  font-size: 15px; font-weight: 700; white-space: nowrap;
  transition: background .18s ease;
}
.h-cta-mini:hover { background: var(--brand-deep); }
.h-cta-mini .wa-glyph { width: 17px; height: 17px; }
@media(max-width:760px) {
  .h-nav { padding: 8px 16px; }
  .h-nav .h-logo { font-size: 22px; }
  .h-nav .h-logo-img { width: 26px; height: 26px; }
  .h-nav .h-logo-name { font-size: 22px; }
  .h-nav-links { display: none; }
  .h-cta-mini { height: 38px; padding: 0 12px; font-size: 14px; gap: 6px; }
}
@media(max-width:360px) { .h-cta-mini .wa-glyph { display: none; } }

/* ── Burger + mobile menu ──────────────────────────────────── */
.h-burger {
  display: none; flex-direction: column; align-items: center; justify-content: center;
  gap: 5px; width: 40px; height: 40px; padding: 0; flex-shrink: 0;
  background: var(--bg); border: 1px solid var(--line); border-radius: 10px;
  cursor: pointer; transition: background .18s ease, border-color .18s ease;
}
.h-burger:hover { background: var(--bg-2); border-color: var(--line-2); }
.h-burger span { display: block; width: 18px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .22s cubic-bezier(.4,0,.2,1), opacity .18s ease; }
.h-burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.h-burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
.h-burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
.h-mm-backdrop {
  position: fixed; inset: 0; z-index: 48;
  background: color-mix(in srgb, var(--ink) 28%, transparent);
  opacity: 0; pointer-events: none; transition: opacity .26s ease;
}
.h-mm-backdrop.open { opacity: 1; pointer-events: auto; }
.h-mobile-menu {
  position: fixed; top: 64px; left: 12px; right: 12px;
  z-index: 49; padding: 12px; display: flex; flex-direction: column; gap: 2px;
  background: #fff;
  border: 1px solid var(--line); border-radius: 18px;
  box-shadow: 0 20px 50px -12px rgba(11,18,32,0.22);
  transform-origin: top center;
  opacity: 0; transform: translateY(-10px) scale(.98); pointer-events: none;
  transition: opacity .24s ease, transform .26s cubic-bezier(.32,.72,0,1);
}
.h-mobile-menu.open { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
.h-mobile-menu a {
  padding: 14px 16px; border-radius: 12px; text-decoration: none;
  color: var(--ink); font-size: 17px; font-weight: 700;
  display: flex; align-items: center; justify-content: space-between;
  transition: background .15s ease;
}
.h-mobile-menu a:not(.h-mm-cta):hover { background: var(--bg-2); }
.h-mobile-menu .h-mm-cta { margin-top: 10px; gap: 9px; justify-content: center; background: var(--brand-ink); color: #fff; }
.h-mobile-menu .h-mm-cta:hover { background: var(--brand-deep); }
.h-mm-note { margin: 8px 0 2px; text-align: center; font-size: 13.5px; color: var(--mute); }
.h-mobile-menu.open a { animation: hmmIn .34s both; }
.h-mobile-menu.open a:nth-child(1) { animation-delay: .03s; }
.h-mobile-menu.open a:nth-child(2) { animation-delay: .06s; }
.h-mobile-menu.open a:nth-child(3) { animation-delay: .09s; }
.h-mobile-menu.open a:nth-child(4) { animation-delay: .12s; }
.h-mobile-menu.open a:nth-child(5) { animation-delay: .15s; }
@keyframes hmmIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
@media(max-width:760px) { .h-burger { display: flex; } }
@media(min-width:761px) { .h-mobile-menu, .h-mm-backdrop { display: none !important; } }

/* ── Footer ────────────────────────────────────────────────── */
.h-foot { position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: 56px clamp(20px,4vw,48px) 36px; border-top: 1px solid var(--line); }
.h-foot-top { display: grid; grid-template-columns: 300px 1fr; gap: 60px; margin-bottom: 36px; }
.h-foot-brand { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
.h-foot-brand .h-logo-img { width: 36px; height: 36px; }
.h-foot-brand .h-logo-name { font-size: 30px; }
.h-foot-brand .h-logo { font-size: 30px; }
.h-foot-tagline { margin: 0; font-size: 15px; color: var(--ink-2); line-height: 1.55; max-width: 260px; }
.h-foot-socials { display: flex; align-items: center; gap: 8px; }
.h-foot-social { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--line); color: var(--ink-2); text-decoration: none; transition: color .18s ease, border-color .18s ease, background .18s ease; }
.h-foot-social:hover { color: var(--brand-ink); border-color: var(--brand-ink); background: var(--brand-soft); }
@media(max-width:720px) { .h-foot-top { grid-template-columns: 1fr; gap: 36px; } }
.h-foot-cols { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
.h-foot-cols h2 { font-family: var(--f-text); font-size: 15px; font-weight: 700; line-height: 1.3; color: var(--ink); margin: 0 0 12px; }
.h-foot-cols a { display: block; color: var(--ink-2); text-decoration: none; font-size: 15px; margin-bottom: 8px; transition: color .18s ease; }
.h-foot-cols a:hover { color: var(--brand-ink); }
@media(max-width:480px) { .h-foot-cols { grid-template-columns: 1fr 1fr; } }
.h-foot-bot { display: flex; justify-content: center; align-items: center; padding-top: 24px; border-top: 1px solid var(--line); color: var(--mute); font-size: 13.5px; }

/* ── Legal pages shared layout ─────────────────────────────── */
.h-legal-wrap {
  position: relative; z-index: 1;
  max-width: 860px; margin: 0 auto;
  padding: clamp(48px,7vw,88px) clamp(20px,4vw,48px) clamp(64px,8vw,96px);
}
.h-legal-inner { display: flex; flex-direction: column; }
.h-legal-back {
  display: inline-flex; align-items: center; gap: 8px;
  color: var(--mute); text-decoration: none; font-size: 15px;
  margin-bottom: 48px; width: fit-content;
  transition: color .15s ease;
}
.h-legal-back svg { width: 16px; height: 16px; }
.h-legal-back:hover { color: var(--brand-ink); }
.h-legal-eyebrow {
  display: inline-block;
  font-size: 15px; font-weight: 700;
  color: var(--brand-ink); margin-bottom: 14px;
}
.h-legal-h1 {
  font-family: var(--f-head); font-weight: 800;
  font-size: var(--t-h2); line-height: .98;
  letter-spacing: -.04em; margin: 0 0 22px; color: var(--ink);
}
.h-legal-lead {
  font-size: clamp(17px,1.4vw,19px); color: var(--ink-2);
  max-width: 620px; margin: 0 0 18px; line-height: 1.6;
}
.h-legal-date { font-size: 14px; color: var(--mute); }
.h-legal-header { padding-bottom: 48px; border-bottom: 1px solid var(--line); margin-bottom: 56px; }
.h-legal-body { display: flex; flex-direction: column; gap: 0; }
.h-legal-section { padding: 32px 0; border-bottom: 1px solid var(--line); }
.h-legal-section:last-child { border-bottom: none; }
.h-legal-section h2 {
  font-family: var(--f-head); font-weight: 800;
  font-size: clamp(20px,2vw,24px); line-height: 1.15; letter-spacing: -.02em;
  color: var(--ink); margin: 0 0 14px;
}
.h-legal-section p { font-size: 16px; color: var(--ink-2); line-height: 1.75; margin: 0 0 14px; }
.h-legal-section p:last-child { margin-bottom: 0; }
.h-legal-section a { color: var(--brand-ink); text-decoration: underline; text-underline-offset: 3px; }
.h-legal-section a:hover { color: var(--brand-deep); }
.h-legal-list { list-style: none; padding: 0; margin: 14px 0; display: flex; flex-direction: column; gap: 10px; }
.h-legal-list li { display: flex; align-items: flex-start; gap: 12px; font-size: 16px; color: var(--ink-2); line-height: 1.65; }
.h-legal-list li::before { content: ''; flex-shrink: 0; width: 12px; height: 7px; margin-top: 7px; border-left: 2px solid var(--brand-ink); border-bottom: 2px solid var(--brand-ink); transform: rotate(-45deg); }
.h-legal-warning { display: flex; align-items: flex-start; gap: 14px; margin-top: 18px; padding: 16px 20px; background: var(--risk-soft); border: 1px solid color-mix(in srgb, var(--plate-red) 25%, var(--line)); border-radius: 14px; }
.h-legal-warning svg { width: 20px; height: 20px; flex-shrink: 0; margin-top: 1px; color: var(--risk); }
.h-legal-warning p { margin: 0 !important; font-size: 15px; color: var(--ink-2); line-height: 1.6; }
.h-legal-warning strong { color: var(--ink); }

@media(max-width:480px) { .h-legal-wrap { padding: 32px 18px 56px; } }

/* ── Focus & reduced motion ────────────────────────────────── */
.h-root a:focus-visible, .h-root button:focus-visible, .h-root summary:focus-visible { outline: 2px solid var(--brand-ink); outline-offset: 3px; border-radius: 8px; }
@media(prefers-reduced-motion:reduce) { *{ animation-duration:.01ms!important; transition-duration:.01ms!important; } }

@media(max-width:480px) {
  .h-foot-bot { flex-direction: column; align-items: center; gap: 10px; }
}

/* ── WhatsApp button (floating) and the phone trial bar ────── */
.h-wa-fab {
  position: fixed; bottom: 24px; right: 24px; z-index: 40;
  display: flex; align-items: center; justify-content: center;
  width: 56px; height: 56px; border-radius: 50%;
  background: var(--wa); color: #fff;
  box-shadow: 0 8px 20px -8px rgba(11,18,32,0.4);
  text-decoration: none;
  transition: transform .2s ease;
}
.h-wa-fab:hover { transform: scale(1.06); }
.h-bar { display: none; }
@media(max-width:760px) {
  .h-wa-fab { bottom: 16px; right: 16px; width: 52px; height: 52px; }
  .h-has-bar .h-wa-fab { display: none; }
  .h-bar {
    display: grid; gap: 6px;
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
    background: #fff; border-top: 1px solid var(--line);
    box-shadow: 0 -12px 28px -20px rgba(11,18,32,.45);
    transform: translateY(110%); visibility: hidden;
    transition: transform .28s cubic-bezier(.22,1,.36,1), visibility 0s linear .28s;
  }
  .h-bar.is-shown { transform: none; visibility: visible; transition: transform .28s cubic-bezier(.22,1,.36,1), visibility 0s; }
}
.h-bar-btn {
  display: flex; align-items: center; justify-content: center; gap: 9px;
  height: 50px; border-radius: 12px;
  background: var(--brand-ink); color: #fff;
  font-weight: 700; font-size: 16px; text-decoration: none;
}
.h-bar-btn .wa-glyph { width: 19px; height: 19px; }
.h-bar-note { margin: 0; text-align: center; font-size: 13px; color: var(--mute); }
</style>
