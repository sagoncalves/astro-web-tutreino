---
// Homepage, in the look reviewed on /v2: League Spartan + Atkinson Hyperlegible Next, the logo
// blue, flat chalk and white bands. Tokens and the type scale live in SiteLayout.
// Content: Tutreino, gym/personal-trainer SaaS with admin panel + member-facing app,
// multi-branch, white label (Pro), AI routines, churn prediction, role permissions.
// Every call to action opens a WhatsApp chat, so each button carries the WhatsApp glyph.
import SiteLayout from '../layouts/SiteLayout.astro';
import WaGlyph from '../components/WaGlyph.astro';
import AppPreview from '../components/AppPreview.astro';
import { createPageMeta, PAGE_META, WA, waLink } from '../utils/meta';
const metaData = createPageMeta('/', PAGE_META.home);
const trialStarter = waLink('Hola, quiero probar el plan Starter de Tutreino 30 días gratis.');
const trialPro = waLink('Hola, quiero probar el plan Pro de Tutreino 30 días gratis.');

// Single source for the visible FAQ and its FAQPage JSON-LD, so they can't drift apart
const faqs = [
  { q: '¿Qué es Tutreino exactamente?', a: 'Es un sistema de gestión para gimnasios y entrenadores personales, disponible como SaaS en app.tutreino.com. Incluye un panel administrativo para tu equipo y una app propia donde tus socios reservan clases, pagan, siguen su rutina y registran su progreso.' },
  { q: '¿Sirve para gimnasios con varias sucursales?', a: 'Sí. Podés gestionar múltiples sedes desde una sola cuenta: agenda, staff, socios y métricas separados por sucursal, con visión consolidada para los administradores generales.' },
  { q: '¿Qué es el white label del plan Pro?', a: 'En el plan Pro, adentro de la app tus socios ven tu logo, tus colores y tu nombre. En las tiendas, la app se publica a nombre de Tutreino. Ideal para gimnasios grandes que quieren su propia identidad.' },
  { q: '¿Cómo funcionan las rutinas con inteligencia artificial?', a: 'El sistema genera rutinas personalizadas según el objetivo, nivel y progreso de cada socio, y las periodiza automáticamente semana a semana. El entrenador puede ajustarlas, combinarlas con su criterio o publicarlas tal cual.' },
  { q: '¿Qué pueden hacer los socios desde su app?', a: 'Reservar clases, pagar membresías (incluyendo pagos recurrentes y por transferencia), ver y seguir su rutina, registrar su progreso y completar formularios de intake, lesiones y satisfacción.' },
  { q: '¿Puedo crear usuarios para mis entrenadores y otros administradores?', a: 'Sí. Podés crear cuentas para entrenadores, recepcionistas u otros administradores, y asignarles permisos según su rol: qué pueden ver, editar o gestionar dentro del sistema.' },
  { q: '¿Cómo ayuda Tutreino a reducir las bajas de socios?', a: 'El sistema analiza asistencia, pagos y respuestas de satisfacción para identificar socios en riesgo de darse de baja, y te avisa antes de que pase para que puedas actuar a tiempo.' },
  { q: '¿Puedo probarlo antes de pagar?', a: 'Sí, 30 días gratis y sin tarjeta. Si no te convence, no pagás nada y conservás todos tus datos.' },
];
const faqCols = [faqs.slice(0, 4), faqs.slice(4)];

// The first quote leads at a larger size; the rest follow in a strip
const quotes = [
  { name: 'Facundo Puigdevall', place: 'SOMA CLUB · Melo, Cerro Largo', text: 'Arrancamos en Melo y no teníamos con qué comparar, pero desde el primer mes dejamos de perder tiempo con planillas y cobros manuales. Hoy nuestros socios reservan y pagan solos y nosotros nos enfocamos en el entrenamiento.' },
  { name: 'Santiago Sosa', place: 'SPORTFIT · Montevideo', text: 'Lanzamos la app con nuestro logo y nuestros colores y los socios la sintieron como propia desde el día uno. Las rutinas con IA nos ahorran horas de planificación cada semana.' },
  { name: 'Martín López', place: 'ACCIONGYM · Mercedes', text: 'Manejo las reservas, los cobros y los permisos del staff desde un solo lugar. Antes era un caos por WhatsApp; ahora veo todo junto y actúo rápido cuando un socio está por darse de baja.' },
  { name: 'Xavier Civitate', place: '1570 House Training · Fray Bentos, Río Negro', text: 'Desde Fray Bentos manejamos todo sin complicaciones. Los socios reservan y pagan desde la app y nosotros no tocamos planillas desde que arrancamos con Tutreino.' },
  { name: 'Agustín Yauza', place: 'Eco Training Club · Montevideo', text: 'El soporte es lo que marca la diferencia: te responden rápido, en español y te ayudan hasta que el problema queda resuelto. Nunca nos sentimos solos con la herramienta.' },
  { name: 'Tomás Pereiro', place: 'Entrenador personal · La Paloma', text: 'Soy entrenador personal y la IA me arma una base sólida para cada cliente según su objetivo. Yo la ajusto con mi criterio y listo. Y los cobros ya no dependen de que yo me acuerde.' },
];
const [leadQuote, ...moreQuotes] = quotes;
// Testimonials are hidden for now; set to true to bring them back (then re-check the chalk/white bands below)
const showTestimonials = false;
---
<SiteLayout {...metaData} home ctaBar>

  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Tutreino",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web",
    "description": "Sistema de gestión para gimnasios de una o varias sucursales y entrenadores personales: reservas, pagos recurrentes, rutinas con inteligencia artificial, predicción de bajas y app propia (con white label) para que los socios entrenen, paguen y sigan su progreso.",
    "offers": [
      {
        "@type": "Offer",
        "name": "Starter",
        "price": "1600",
        "priceCurrency": "UYU",
        "description": "Hasta 500 socios, una sucursal, reservas de clases, pagos recurrentes y por transferencia, app para socios"
      },
      {
        "@type": "Offer",
        "name": "Pro",
        "price": "2600",
        "priceCurrency": "UYU",
        "description": "Socios y sucursales ilimitadas, app con white label, rutinas con IA y periodización automática, predicción de bajas, permisos por rol, seguimiento de lesiones y progreso"
      }
    ]
  })} />

  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />

    <!-- hero: white label, tu app con tu marca -->
    <header class="h-hero" id="inicio" data-cta-bar-hide>
      <div class="h-wrap h-hero-copy">
        <p class="h-hero-kicker">¿Líder de gimnasio? ¿Entrenador personal?</p>
        <h1 class="h-h1">Tu app.<br/><span class="h-accent">Tu marca.</span></h1>
        <p class="h-hero-sub">Tus socios reservan, pagan y ven su rutina desde una app que dice <b>tu nombre</b>, con <b>tu logo</b> y <b>tus colores</b>. Vos manejás todo desde un solo panel.</p>
        <div class="h-hero-ctas">
          <a href={WA.trial} class="h-btn" target="_blank" rel="noopener noreferrer"><WaGlyph />Probar 30 días gratis</a>
          <a href="#socios" class="h-link">Mirá tu app con tu logo <span aria-hidden="true">↓</span></a>
        </div>
      </div>

      <div class="h-wl-grid" aria-hidden="true">
        <!-- Gimnasio 1, azul -->
        <figure class="h-phone" style="--gym:#1d4ed8;--gym-soft:#dbeafe;">
          <div class="h-phone-frame">
            <div class="h-phone-notch"></div>
            <div class="h-phone-screen">
              <div class="h-app-top">
                <span class="h-app-logo"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 4h3v16H6zm9 0h3v16h-3zM4 9h16v6H4z"/></svg>IRON HOUSE</span>
              </div>
              <div class="h-app-hero">Hola, Marcos 👊</div>
              <div class="h-app-card primary">Tu clase de hoy<b>Funcional · 19:00</b></div>
              <div class="h-app-card">Próximo pago<b>en 6 días · automático</b></div>
              <div class="h-app-card">Tu rutina<b>Día 2 · Tren inferior</b></div>
              <div class="h-app-nav"><span class="on"></span><span></span><span></span><span></span></div>
            </div>
          </div>
        </figure>

        <!-- Gimnasio 2, verde -->
        <figure class="h-phone featured" style="--gym:#047857;--gym-soft:#d1fae5;">
          <div class="h-phone-frame">
            <div class="h-phone-notch"></div>
            <div class="h-phone-screen">
              <div class="h-app-top">
                <span class="h-app-logo"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 4 7v10l8 5 8-5V7zm0 4 4 2.5v5L12 16l-4-2.5v-5z"/></svg>ZEN STUDIO</span>
              </div>
              <div class="h-app-hero">Hola, Camila 🌿</div>
              <div class="h-app-card primary">Tu clase de hoy<b>Yoga Flow · 08:00</b></div>
              <div class="h-app-card">Tu rutina<b>generada con IA</b></div>
              <div class="h-app-card">Esta semana<b>3 clases reservadas</b></div>
              <div class="h-app-nav"><span class="on"></span><span></span><span></span><span></span></div>
            </div>
          </div>
        </figure>

        <!-- Gimnasio 3, naranja -->
        <figure class="h-phone" style="--gym:#c2410c;--gym-soft:#ffedd5;">
          <div class="h-phone-frame">
            <div class="h-phone-notch"></div>
            <div class="h-phone-screen">
              <div class="h-app-top">
                <span class="h-app-logo"><svg viewBox="0 0 24 24" fill="currentColor"><path d="m13 2-9 12h7l-2 8 9-12h-7z"/></svg>FLOW GYM</span>
              </div>
              <div class="h-app-hero">Hola, Diego ⚡</div>
              <div class="h-app-card primary">Tu clase de hoy<b>Spinning · 20:30</b></div>
              <div class="h-app-card">Tu progreso<b>+4kg este mes</b></div>
              <div class="h-app-card">Tu racha<b>12 días seguidos</b></div>
              <div class="h-app-nav"><span class="on"></span><span></span><span></span><span></span></div>
            </div>
          </div>
        </figure>
      </div>

      <div class="h-proof">
        <p class="h-wrap">Ya lo usan gimnasios en <b>todo Uruguay y Argentina</b>.</p>
      </div>
    </header>

    <!-- socios: el dueño prueba su marca en la app, pantalla por pantalla -->
    <AppPreview />

    <!-- producto: cobros (con los medios de pago) y retención -->
    <section class="h-section h-chalk" id="producto">
      <div class="h-wrap">
        <div class="h-head">
          <h2 class="h-h2">Un sistema.<br/>Todo tu gimnasio.</h2>
          <p class="h-sub">No es una planilla con más botones. Es el sistema que cobra solo, retiene socios y entrena por vos, con tu marca adelante.</p>
        </div>

        <!-- BLOQUE 1: cobros -->
        <div class="h-feat" id="cobros">
          <div class="h-feat-copy">
            <h3 class="h-feat-h">Cobrás sin perseguir a nadie.</h3>
            <p class="h-feat-lead">Recordatorio, link de pago y confirmación salen solos. Vos abrís el panel y el dinero ya entró.</p>
            <ul class="h-feat-pts">
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><b>Más cobranza puntual.</b> Se acabó el “te pago la semana que viene”.</span></li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><b>Cero recepción.</b> El socio paga desde su app, no en el mostrador.</span></li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><b>Planes a medida.</b> Mensual, anual, pase libre o por clase.</span></li>
            </ul>
            <div class="h-paym">
              <p class="h-paym-h">Cada socio paga como prefiere</p>
              <ul class="h-paym-list">
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4" stroke-linecap="round"/></svg><span><b>Tarjeta recurrente</b>Se cobra sola, mes a mes</span></li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 10h18M3 6h18M5 14h6m-6 4h10" stroke-linecap="round"/></svg><span><b>Transferencia</b>Con comprobante y conciliación</span></li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" stroke-linecap="round" stroke-linejoin="round"/></svg><span><b>Por clase o pase libre</b>Cobros sueltos, sin membresía fija</span></li>
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 13l4-4 4 3 7-7M14 5h4v4" stroke-linecap="round" stroke-linejoin="round"/></svg><span><b>Todo conciliado</b>Cada pago queda registrado en el panel</span></li>
              </ul>
            </div>
          </div>

          <!-- mockup: panel de cobros -->
          <div class="h-feat-vis" aria-hidden="true">
            <div class="h-screen-body">
              <div class="h-stat-row">
                <div class="h-stat">
                  <span class="h-stat-lbl">Ingreso del mes</span>
                  <span class="h-stat-val">$ 684.500</span>
                  <span class="h-stat-trend up">▲ 18% vs. mes anterior</span>
                </div>
                <div class="h-stat">
                  <span class="h-stat-lbl">Cobrado solo</span>
                  <span class="h-stat-val">94<small>%</small></span>
                  <span class="h-stat-trend">312 de 332 socios</span>
                </div>
              </div>
              <div class="h-pay-list">
                <div class="h-pay"><span class="h-pay-av">MG</span><div class="h-pay-body"><b>Marcos G.</b><small>Plan mensual · débito automático</small></div><span class="h-pay-amt ok">$ 2.200 ✓</span></div>
                <div class="h-pay"><span class="h-pay-av">LR</span><div class="h-pay-body"><b>Lucía R.</b><small>Mensual · link enviado</small></div><span class="h-pay-amt wait">$ 1.800 · pendiente</span></div>
                <div class="h-pay"><span class="h-pay-av">DC</span><div class="h-pay-body"><b>Diego C.</b><small>Anual · transferencia</small></div><span class="h-pay-amt ok">$ 24.000 ✓</span></div>
                <div class="h-pay"><span class="h-pay-av">AT</span><div class="h-pay-body"><b>Ana T.</b><small>Plan mensual · débito automático</small></div><span class="h-pay-amt ok">$ 2.200 ✓</span></div>
              </div>
            </div>
          </div>
        </div>

        <!-- BLOQUE 2: retención + IA (mockup a la izquierda) -->
        <div class="h-feat reverse" id="retencion">
          <div class="h-feat-copy">
            <h3 class="h-feat-h">Sabés quién se va antes de que se vaya.</h3>
            <p class="h-feat-lead">El sistema lee asistencia, pagos y uso, y te avisa qué socios están por darse de baja, con tiempo para hacer algo. Y arma las rutinas que los mantienen enganchados.</p>
            <ul class="h-feat-pts">
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><b>Alertas de riesgo de baja</b> antes de que dejen de venir.</span></li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><b>Rutinas con IA en segundos,</b> periodizadas por objetivo y nivel.</span></li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg><span><b>El entrenador ajusta,</b> la IA hace el trabajo pesado.</span></li>
            </ul>
          </div>

          <!-- mockup: alerta de retención -->
          <div class="h-feat-vis" aria-hidden="true">
            <div class="h-screen-body">
              <div class="h-alert">
                <div class="h-alert-head"><span class="h-alert-pulse"></span><b>4 socios en riesgo de baja</b></div>
                <p>No asisten hace 12+ días y su pago vence pronto. Contactalos ahora.</p>
              </div>
              <div class="h-risk">
                <div class="h-risk-row"><span class="h-pay-av">SF</span><div class="h-pay-body"><b>Sofía F.</b><small>Sin venir hace 14 días</small></div><span class="h-risk-tag hi">Riesgo alto</span></div>
                <div class="h-risk-row"><span class="h-pay-av">NM</span><div class="h-pay-body"><b>Nahuel M.</b><small>Asistencia ↓ 60%</small></div><span class="h-risk-tag hi">Riesgo alto</span></div>
                <div class="h-risk-row"><span class="h-pay-av">VP</span><div class="h-pay-body"><b>Valentina P.</b><small>Pago vence en 2 días</small></div><span class="h-risk-tag md">Riesgo medio</span></div>
              </div>
              <div class="h-ai-chip">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v3m0 12v3M3 12h3m12 0h3m-2.5-6.5-2 2m-9 9-2 2m0-13 2 2m9 9 2 2"/></svg>
                <span>IA generó <b>3 rutinas nuevas</b> para reactivarlos</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- flujo: puesta en marcha en tres pasos -->
    <section class="h-section" id="flujo">
      <div class="h-wrap">
        <div class="h-head">
          <p class="h-kicker">Tu puesta en marcha</p>
          <h2 class="h-h2 h-h2-quiet">En un día, listo para siempre.</h2>
        </div>
        <ol class="h-flow">
          <li>
            <div class="h-flow-num" aria-hidden="true">1</div>
            <div class="h-flow-card">
              <h3>Configurás tu gimnasio</h3>
              <p>Cargás sucursales, planes, horarios y permisos para tu equipo. Si tenés varias sedes, cada una con su propia agenda y staff.</p>
              <div class="h-flow-tags">
                <span class="h-flow-tag">2 sucursales</span>
                <span class="h-flow-tag">Horarios</span>
                <span class="h-flow-tag">Permisos de equipo</span>
              </div>
            </div>
          </li>
          <li>
            <div class="h-flow-num" aria-hidden="true">2</div>
            <div class="h-flow-card">
              <h3>Invitás a tus socios</h3>
              <p>Importás tu base desde Excel o los invitás uno a uno. Cada socio entra a su propia app: reserva, paga y carga su ficha de salud y objetivos.</p>
              <div class="h-flow-tags">
                <span class="h-flow-tag">248 socios importados</span>
                <span class="h-flow-tag success">Invitaciones enviadas ✓</span>
              </div>
            </div>
          </li>
          <li>
            <div class="h-flow-num" aria-hidden="true">3</div>
            <div class="h-flow-card">
              <h3>La plataforma escala con vos</h3>
              <p>Cobros recurrentes, recordatorios, reservas, rutinas con IA y alertas de bajas. Tu equipo decide; el sistema hace el trabajo repetitivo.</p>
              <div class="h-flow-tags">
                <span class="h-flow-tag success">● En vivo</span>
                <span class="h-flow-tag">248 socios activos</span>
                <span class="h-flow-tag">12 rutinas IA generadas hoy</span>
              </div>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- testimonios (hidden for now, see showTestimonials) -->
    {showTestimonials && (
    <section class="h-section h-chalk" id="testimonios">
      <div class="h-wrap">
        <div class="h-head">
          <h2 class="h-h2">Gimnasios que ya dejaron el Excel.</h2>
          <p class="h-sub">Líderes de gimnasio y entrenadores personales gestionan su negocio con Tutreino todos los días.</p>
        </div>
        <div class="h-quotes">
          <figure class="h-quote h-quote-lead">
            <blockquote><p>“{leadQuote.text}”</p></blockquote>
            <figcaption><b>{leadQuote.name}</b><span>{leadQuote.place}</span></figcaption>
          </figure>
          <div class="h-quotes-rest">
            {moreQuotes.map((q) => (
              <figure class="h-quote">
                <blockquote><p>“{q.text}”</p></blockquote>
                <figcaption><b>{q.name}</b><span>{q.place}</span></figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>
    )}

    <!-- comparativa -->
    <section class="h-section h-chalk" id="comparativa">
      <div class="h-wrap">
        <div class="h-head">
          <h2 class="h-h2 h-h2-quiet">Planillas y grupos tienen un techo.</h2>
          <p class="h-sub">Excel, WhatsApp y libretas no escalan ni te dan una app para tus socios.</p>
        </div>
        <div class="h-cmp">
          <div class="h-cmp-panel h-cmp-before">
            <p class="h-cmp-label">Antes</p>
            <p class="h-cmp-sub">Planillas + WhatsApp</p>
            <ul class="h-cmp-list">
              <li><span class="h-cmp-mark" aria-hidden="true">✕</span>Mensajes sueltos, sin un lugar propio</li>
              <li><span class="h-cmp-mark" aria-hidden="true">✕</span>Cobro manual, mes a mes</li>
              <li><span class="h-cmp-mark" aria-hidden="true">✕</span>Reservas por grupos de WhatsApp</li>
              <li><span class="h-cmp-mark" aria-hidden="true">✕</span>Hojas sueltas, sin seguimiento de rutinas</li>
              <li><span class="h-cmp-mark" aria-hidden="true">✕</span>Información dispersa por sucursal</li>
              <li><span class="h-cmp-mark" aria-hidden="true">✕</span>Te enterás de las bajas cuando ya pasaron</li>
            </ul>
          </div>
          <div class="h-cmp-panel h-cmp-after">
            <p class="h-cmp-label"><img src="/favicon-96x96.png" alt="" width="28" height="28" />Con tutreino</p>
            <p class="h-cmp-sub">Todo en un lugar</p>
            <ul class="h-cmp-list">
              <li><span class="h-cmp-mark" aria-hidden="true">✓</span>App propia con tu marca (plan Pro)</li>
              <li><span class="h-cmp-mark" aria-hidden="true">✓</span>Cobro recurrente por tarjeta o transferencia</li>
              <li><span class="h-cmp-mark" aria-hidden="true">✓</span>Agenda online desde la app del socio</li>
              <li><span class="h-cmp-mark" aria-hidden="true">✓</span>Rutinas con IA, periodizadas y con progreso</li>
              <li><span class="h-cmp-mark" aria-hidden="true">✓</span>Vista consolidada y por sucursal</li>
              <li><span class="h-cmp-mark" aria-hidden="true">✓</span>Alertas de riesgo antes de que se vayan</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- precios -->
    <section class="h-section" id="precios">
      <div class="h-wrap">
        <div class="h-head h-head-center">
